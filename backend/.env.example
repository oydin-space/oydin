DJANGO_SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://oydin:oydin@127.0.0.1:5433/oydin
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3010
# OpenRouter (OpenAI-совместимый API); без ключа чат работает на детерминированных ответах
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.1-flash-lite
LLM_CLASSIFY_MODEL=google/gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=google/gemini-3.5-flash
# модель с аудио-входом для голосового ввода
STT_MODEL=google/gemini-3.5-flash-lite
# Langfuse: пустые ключи = трейсинг выключен
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
TELEGRAM_BOT_TOKEN=
# 1 — разрешить вход в демо-бизнес Print Lab
DEMO_LOGIN=1
# Вход по email-коду: SMTP. Без EMAIL_HOST письма пишутся в консоль (только DEBUG), в проде вход по email выключен
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Oydin <noreply@oydin.sayfi.uz>
# Google-вход: OAuth client (Web), redirect URI = <host>/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Суперпользователь для /admin/ (создаётся при старте контейнера)
ADMIN_EMAIL=
ADMIN_PASSWORD=
