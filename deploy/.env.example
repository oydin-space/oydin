# На сервере: ~/oydin/.env (chmod 600). Реальные значения не коммитить.
PUBLIC_HOST=oydin.sayfi.uz
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# 1 — вход в синтетический демо-бизнес (для жюри)
DEMO_LOGIN=1
TELEGRAM_BOT_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.5-flash
LLM_FALLBACK_MODEL=google/gemini-3.1-flash-lite
STT_MODEL=google/gemini-3.5-flash-lite
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Вход по email-коду (SMTP); пусто = вход по email выключен
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Oydin <noreply@oydin.sayfi.uz>
# Google-вход; redirect URI = https://oydin.sayfi.uz/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Суперпользователь для /admin/
ADMIN_EMAIL=
ADMIN_PASSWORD=
