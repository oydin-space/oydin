# На сервере: ~/oydin/.env (chmod 600). Реальные значения не коммитить.
PUBLIC_HOST=oydin.sayfi.uz
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# 1 — вход в синтетический демо-бизнес (для жюри)
DEMO_LOGIN=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=oydin_agent
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.1-flash-lite
LLM_CLASSIFY_MODEL=google/gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=google/gemini-3.5-flash
# Exa: веб-поиск и исследование для ИИ; пусто — выключено
EXA_API=
# Запасной провайдер, если OpenRouter недоступен
ANTHROPIC_API_KEY=
STT_MODEL=google/gemini-3.5-flash-lite
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Вход по email-коду (SMTP); пусто = вход по email выключен
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Oydin <noreply@oydin.sayfi.uz>
# Google-вход; redirect URI = https://oydin.sayfi.uz/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Суперпользователь для /admin/
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Bugsink (bugsink.oydin.sayfi.uz): deploy сам дописывает BUGSINK_* случайными значениями, если их нет
BUGSINK_HOST=bugsink.oydin.sayfi.uz
BUGSINK_SECRET_KEY=
BUGSINK_ADMIN_EMAIL=
BUGSINK_ADMIN_PASSWORD=
# DSN проекта из Bugsink; пусто = ошибки не отправляются
SENTRY_DSN=
# Статика документации (docs-site/)
DOCS_HOST=docs.oydin.sayfi.uz
# Оплата тарифов через Click (SHOP API); false или пустые ключи = оплата недоступна
PAYMENTS_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# HashiCorp Vault (Transit, ключ oydin-creds) для паролей Didox и секретов коннекторов.
# Пусто = секреты шифруются Fernet от DJANGO_SECRET_KEY. Заполнять только после инициализации по deploy/vault/README.md.
VAULT_ADDR=
VAULT_TOKEN=
