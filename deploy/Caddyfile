{$PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Django ждёт завершающий слеш (как в rewrite Next)
	@noslash path_regexp noslash ^/api/(.*[^/])$
	rewrite @noslash /api/{re.noslash.1}/

	@django path /api/* /admin/* /admin /static/*
	handle @django {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3010
	}
}

# Трекер ошибок Bugsink (TLS автоматически)
{$BUGSINK_HOST} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy bugsink:8000
}

# Документация для разработчиков: статика из docs-site/
{$DOCS_HOST} {
	encode zstd gzip
	root * /srv/docs-site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}
	file_server
}

# Старый домен: постоянный редирект на новый хост с тем же путём
{$OLD_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$PUBLIC_HOST}{uri} permanent
}

docs.{$OLD_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$DOCS_HOST}{uri} permanent
}
